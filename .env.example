# ======================
# Typeset Configuration
# ======================

# JWT secret for session tokens (REQUIRED in production)
JWT_SECRET=your-secret-key-here

# ======================
# MCP Authentication
# ======================
# Set to require API key for MCP endpoint. Leave empty for open access.
# Agents authenticate with: Authorization: Bearer <MCP_API_KEY>
# Users can also use their session JWT: Authorization: Bearer <jwt>
# MCP_API_KEY=your-mcp-api-key-here

# ======================
# Database Adapter
# ======================
# Options: memory (default), mongodb, d1
DB_ADAPTER=memory

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=typeset

# --- Cloudflare D1 ---
# D1 uses a Workers binding (DB) configured in wrangler.toml.
# No env vars needed here — the binding is auto-detected at runtime.

# ======================
# Storage Adapter
# ======================
# Options: fs (default), s3, r2
STORAGE_ADAPTER=fs

# --- Filesystem ---
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

# --- AWS S3 ---
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=secret
S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
# S3_ENDPOINT=               # Custom endpoint (for MinIO, etc.)
# S3_FORCE_PATH_STYLE=false  # Set true for MinIO/custom endpoints

# --- Cloudflare R2 ---
# Option A: Workers binding (auto-detected at runtime, no env vars needed)
# Option B: S3-compatible API (for use outside Cloudflare)
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_PUBLIC_URL=https://pub-xxx.r2.dev
